<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- 伙伴应用（Clash Meta for Android）可见性：Android 11+ 下若不声明，
         检测安装状态与读取只读 partnerStatus 都会被包可见性过滤挡住。 -->
    <queries>
        <package android:name="com.github.metacubex.clash" />
        <package android:name="com.github.metacubex.clash.alpha" />
        <package android:name="com.github.metacubex.clash.meta" />
        <package android:name="com.github.kr328.clash" />
    </queries>
    <application
        android:name=".CDictApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="CDict"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CDict">
        <!-- 向 Clash Meta for Android 声明伙伴身份：被其 PartnerApps 注册表识别后，
             CDict 会自动纳入 VPN 访问控制，并可读取只读的 partnerStatus。 -->
        <meta-data
            android:name="com.github.kr328.clash.partner"
            android:value="true" />
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- 选中文字后系统工具条（复制 / 全选 那一条）里的「CDict 翻译」入口。
             PROCESS_TEXT 是该工具条接入第三方应用的标准动作；TRANSLATE / DEFINE 覆盖部分 ROM 与
             阅读类应用改用 EXTRA_TEXT 发起的划词翻译 / 取词释义。透明主题 + 独立任务，
             只从底部升起翻译弹窗，不进入主界面。 -->
        <activity
            android:name=".quicktranslate.QuickTranslateActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="CDict 翻译"
            android:taskAffinity=""
            android:theme="@style/Theme.CDict.QuickTranslate">
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.TRANSLATE" />
                <action android:name="android.intent.action.DEFINE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
