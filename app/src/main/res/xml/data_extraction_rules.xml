<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (API 31+) backup/transfer rules. -->
<!-- dict.db is decompressed from the bundled Brotli asset (dict.db.br) on first
     launch, so excluding it keeps cloud backups / device transfers small and fast. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude
            domain="database"
            path="dict.db" />
        <!-- 网络限流分桶用的安装标识：不随备份跨设备迁移，否则它的生命周期比这次安装更长。 -->
        <exclude
            domain="sharedpref"
            path="cdict_network.xml" />
    </cloud-backup>
    <!-- Device-to-device transfer keeps the same exclusions to match cloud backups. -->
    <device-transfer>
        <exclude
            domain="database"
            path="dict.db" />
        <exclude
            domain="sharedpref"
            path="cdict_network.xml" />
    </device-transfer>
</data-extraction-rules>