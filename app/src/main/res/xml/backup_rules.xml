<?xml version="1.0" encoding="utf-8"?>
<!-- Auto Backup rules for Android 11 and lower (API 26-30). -->
<!-- Same rationale as data_extraction_rules.xml: dict.db is decompressed from
     the bundled Brotli asset (dict.db.br), so it is excluded to keep backups
     small and fast. -->
<full-backup-content>
    <exclude
        domain="database"
        path="dict.db" />
    <!-- 网络限流分桶用的安装标识：不随备份跨设备迁移，否则它的生命周期比这次安装更长。 -->
    <exclude
        domain="sharedpref"
        path="cdict_network.xml" />
</full-backup-content>